PORT=5000

# ===== DATABASE CONFIGURATION =====
# Required: MongoDB connection string
# For local development: mongodb://localhost:27017/nestro
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/nestro
MONGODB_URI=mongodb://localhost:27017/nestro

# ===== EMAIL SERVICE CONFIGURATION =====
# Brevo Email Service (Professional email service)
# Get API key from https://www.brevo.com/
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Your App Name

# ===== CLOUDINARY CONFIGURATION =====
# Image upload and storage service
# Get credentials from https://cloudinary.com/
CLOUD_NAME=your_cloud_name
API_KEY=your_api_key
API_SECRET=your_api_secret

# ===== PAYMENT CONFIGURATION =====
# Razorpay payment gateway
# Get keys from https://razorpay.com/
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ===== LEGACY EMAIL CONFIGURATION =====
# Gmail/Nodemailer (Alternative email option)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here