PORT=5000

# ===== DATABASE CONFIGURATION =====
# Option 1: MongoDB Atlas (Cloud) - RECOMMENDED for production
# Sign up at https://www.mongodb.com/cloud/atlas
# Create free M0 cluster and get connection string
# MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nestro?retryWrites=true&w=majority

# Option 2: Local MongoDB (for development)
# Download from https://www.mongodb.com/try/download/community  
# Windows: net start MongoDB | Mac: brew services start mongodb-community
MONGODB_URL=mongodb://localhost:27017/nestro

# ===== EMAIL SERVICE CONFIGURATION =====
# Brevo Email Service (Recommended - Professional & reliable)
# Sign up at https://www.brevo.com/ and get API key from dashboard
